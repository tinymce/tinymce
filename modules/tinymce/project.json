{
  "name": "tinymce",
  "tags": [ "open-source", "editor" ],
  "targets": {
    "build": {
      "inputs": [
        "tiny-product",
        "^tiny-library"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/js",
        "{projectRoot}/lib",
        "{projectRoot}/src/plugins/emoticons/main/js",
        "{projectRoot}/src/plugins/help/main/js/i18n"
      ]
    }
  }
}
