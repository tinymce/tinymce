exports[`browser.bespoke.tinymceai.Tag > Snapshot Tests > TINYMCE-14505: Should match snapshot for a closeable tag > Closeable tag 1`] = `
<DocumentFragment>
  <div
    class="tox"
  >
    <div
      class="tox-tag"
      tabindex="-1"
    >
      <span
        class="tox-tag__label"
      >
        Closeable tag
      </span>
      <span
        class="tox-tag__close"
      >
        <button
          class="tox-button tox-button--naked tox-button--icon"
          type="button"
        >
          <span
            class="tox-icon"
          >
            <svg
              id="source-close"
            />
          </span>
        </button>
      </span>
    </div>
  </div>
</DocumentFragment>
`;

exports[`browser.bespoke.tinymceai.Tag > Snapshot Tests > TINYMCE-14505: Should match snapshot for a disabled closeable tag with an aria-label > Disabled closeable tag 1`] = `
