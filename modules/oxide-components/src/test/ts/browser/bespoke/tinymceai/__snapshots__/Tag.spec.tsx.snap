  <div
    class="tox"
  >
    <div
      class="tox-tag"
      disabled=""
      tabindex="-1"
    >
      <span
        class="tox-tag__label"
      >
        Disabled tag
      </span>
      <span
        class="tox-tag__close"
      >
        <button
          aria-label="Disabled tag"
          class="tox-button tox-button--naked tox-button--icon"
          disabled=""
          type="button"
        >
