{
  "name": "@tinymce/oxide-components",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinymce/tinymce.git",
    "directory": "modules/oxide-components"
  },
  "description": "React component library for TinyMCE rich text editor",
  "author": "Ephox Corporation DBA Tiny Technologies, Inc",
  "bugs": {
    "url": "https://github.com/tinymce/tinymce/issues"
  },
  "license": "GPL-2.0-or-later",
  "sideEffects": false,
  "files": [
    "lib/main",
    "src",
    "tsconfig.json",
    "README.md",
    "LEGAL.txt",
    "CHANGELOG.txt",
    "LICENSE.txt"
  ],
  "main": "./lib/main/ts/Main.js",
  "module": "./lib/main/ts/Main.js",
  "types": "./lib/main/ts/Main.d.ts",
  "exports": {
    ".": {
      "tiny:source": "./src/main/ts/Main.ts",
      "types": "./lib/main/ts/Main.d.ts",
      "default": "./lib/main/ts/Main.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "bun build-storybook && tsc -b",
    "lint": "eslint --max-warnings=0 'src/**/*.ts' 'src/**/*.tsx'",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "gh-pages -d ./storybook-static --nojekyll --dest modules/oxide-components",
    "test-watch": "vitest --project '!visual'",
    "test": "echo 'No tests'",
    "test-visual-ci": "node ./visual-regression-test-ci.mjs",
    "test-visual-local": "node ./visual-regression-test.mjs",
    "test-visual-local-update": "node ./visual-regression-test.mjs update",
    "test-snapshot-update": "vitest --watch=false --update --project browser",
    "node-test": "vitest --watch=false --project atomic --reporter=default",
    "test-ci": "vitest --watch=false --project '!visual' --reporter=default --reporter=junit --outputFile=scratch/test-results.xml",
    "test-browser-manual": "vitest --watch --project '!visual' --browser.headless false",
    "test-browser-headless": "vitest --watch --project '!visual'",
    "ci": "npm exec --prefix ../../ lerna -- run --scope @tinymce/oxide-components --include-dependencies build && npm-run-all -p lint test"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tinymce/oxide": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "10.6.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "10.6.1",
    "storybook-addon-pseudo-states": "10.6.1",
    "terser": "^5.51.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^1.0.1"
  },
  "dependencies": {
    "@ephox/katamari": "^11.0.0",
    "@ephox/sand": "^8.0.0",
    "@ephox/sugar": "^11.0.0"
  }
}
